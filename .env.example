# Placeholder names only. Nothing here is read by the offline demo.
# When going live, copy these values into the "Config" node and into n8n credentials
# (see "Going live" in README.md). Never commit a real .env file.

# Supplier feed endpoints (Config node: supplierAUrl, supplierBUrl, supplierCUrl)
SUPPLIER_A_JSON_URL=https://supplier-a.example.com/api/products
SUPPLIER_B_CSV_URL=https://supplier-b.example.com/export/products.csv
SUPPLIER_C_XML_URL=https://supplier-c.example.com/feeds/products.xml

# Postgres (n8n credential type: Postgres)
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# Google Sheets (Config node: googleSheetId; n8n credential type: Google Sheets OAuth2)
GOOGLE_SHEET_ID=REPLACE_WITH_GOOGLE_SHEET_ID

# Slack (Config node: slackChannel; n8n credential type: Slack API)
SLACK_CHANNEL=#product-feed
