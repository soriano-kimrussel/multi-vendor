{
  "name": "Multi-Vendor Product Feed Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "1a222222-2222-4222-8222-222222222201",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "https://supplier-a.example.com/products.csv",
        "options": {}
      },
      "id": "1a222222-2222-4222-8222-222222222202",
      "name": "Supplier A Feed (CSV)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 40]
    },
    {
      "parameters": {
        "url": "https://supplier-b.example.com/products.xml",
        "options": {}
      },
      "id": "1a222222-2222-4222-8222-222222222203",
      "name": "Supplier B Feed (XML)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://supplier-c.example.com/products.json",
        "options": {}
      },
      "id": "1a222222-2222-4222-8222-222222222204",
      "name": "Supplier C Feed (JSON)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 560]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: { ...item.json, supplier: 'Supplier A' } }));"
      },
      "id": "1a222222-2222-4222-8222-222222222205",
      "name": "Parse Supplier A",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 40]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: { ...item.json, supplier: 'Supplier B' } }));"
      },
      "id": "1a222222-2222-4222-8222-222222222206",
      "name": "Parse Supplier B",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: { ...item.json, supplier: 'Supplier C' } }));"
      },
      "id": "1a222222-2222-4222-8222-222222222207",
      "name": "Parse Supplier C",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 560]
    },
    {
      "parameters": {
        "mode": "append",
        "numberInputs": 3
      },
      "id": "1a222222-2222-4222-8222-222222222208",
      "name": "Merge Supplier Feeds",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const row = item.json;\n  const rawSku = row.product_code ?? row.sku ?? row.id ?? '';\n  const sku = String(rawSku).trim().toUpperCase().replace(/[^A-Z0-9]/g, '');\n  const name = String(row.product_name ?? row.name ?? row.title ?? '').trim();\n  const rawCost = row.cost ?? row.wholesale_price ?? row.price;\n  const cost = Number(rawCost);\n  const rawInventory = row.stock ?? row.quantity_available ?? row.qty;\n  const inventory = Number(rawInventory);\n  const valid = sku.length > 0 && name.length > 0 && Number.isFinite(cost) && cost > 0 && Number.isFinite(inventory) && inventory >= 0;\n  return { json: { ...row, rawSku: String(rawSku), sku, name, cost, inventory, currency: 'USD', status: valid ? 'active' : 'rejected' } };\n});"
      },
      "id": "1a222222-2222-4222-8222-222222222209",
      "name": "Normalize Product Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1a222222-2222-4222-8222-222222222210",
              "leftValue": "={{ $json.status }}",
              "rightValue": "active",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a222222-2222-4222-8222-222222222211",
      "name": "IF Product Is Active",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: { ...item.json, sellingPrice: Math.round(item.json.cost * 1.5 * 100) / 100, markupMultiplier: 1.5 } }));"
      },
      "id": "1a222222-2222-4222-8222-222222222212",
      "name": "Calculate Selling Price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1370, 180]
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nreturn $input.all().map(item => {\n  const skuMatch = seen.has(item.json.sku) ? 'duplicate_in_feed' : 'unique_in_feed';\n  seen.add(item.json.sku);\n  return { json: { ...item.json, skuMatch } };\n});"
      },
      "id": "1a222222-2222-4222-8222-222222222213",
      "name": "SKU Matching",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1590, 180]
    },
    {
      "parameters": {
        "jsCode": "const existingStock = { AB100: 5, BC200: 12 };\nreturn $input.all().map(item => {\n  const exists = Object.prototype.hasOwnProperty.call(existingStock, item.json.sku);\n  const existingInventory = exists ? existingStock[item.json.sku] : null;\n  return { json: { ...item.json, existingInventory, inventoryDelta: exists ? item.json.inventory - existingInventory : item.json.inventory, action: exists ? 'update' : 'insert' } };\n});"
      },
      "id": "1a222222-2222-4222-8222-222222222214",
      "name": "Inventory Reconciliation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1810, 180]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": {
          "__rl": true,
          "mode": "list",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "products"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "sku": "={{ $json.sku }}",
            "name": "={{ $json.name }}",
            "cost": "={{ $json.cost }}",
            "inventory": "={{ $json.inventory }}",
            "currency": "={{ $json.currency }}",
            "selling_price": "={{ $json.sellingPrice }}",
            "supplier": "={{ $json.supplier }}",
            "action": "={{ $json.action }}"
          },
          "matchingColumns": ["sku"],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "1a222222-2222-4222-8222-222222222215",
      "name": "Database Upsert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [2030, 180],
      "disabled": true,
      "notes": "Disabled for local demo; enable and add a Postgres credential to persist rows."
    },
    {
      "parameters": {
        "jsCode": "const products = $input.all().map(item => item.json);\nconst inserts = products.filter(product => product.action === 'insert').length;\nconst updates = products.filter(product => product.action === 'update').length;\nreturn [{ json: { generatedAt: new Date().toISOString(), processed: products.length, inserts, updates, rejected: 0, suppliers: [...new Set(products.map(product => product.supplier))], products } }];"
      },
      "id": "1a222222-2222-4222-8222-222222222216",
      "name": "Generate Processing Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2250, 180]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Processing Report"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "1a222222-2222-4222-8222-222222222217",
      "name": "Report to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [2500, 80],
      "disabled": true,
      "notes": "Disabled for local demo; add a Google Sheets credential and sheet ID to publish reports."
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "REPLACE_WITH_SLACK_CHANNEL"
        },
        "text": "={{ `Product feed complete: ${$json.processed} processed, ${$json.inserts} inserts, ${$json.updates} updates.` }}",
        "otherOptions": {}
      },
      "id": "1a222222-2222-4222-8222-222222222218",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [2500, 280],
      "disabled": true,
      "notes": "Disabled for local demo; add a Slack credential and channel to send notifications."
    },
    {
      "parameters": {
        "jsCode": "const rejected = $input.all().map(item => ({ sku: item.json.sku, rawSku: item.json.rawSku, name: item.json.name, cost: item.json.cost, inventory: item.json.inventory, supplier: item.json.supplier, reason: [!item.json.sku && 'missing SKU', !item.json.name && 'missing name', !(item.json.cost > 0) && 'cost must be greater than zero', !(item.json.inventory >= 0) && 'inventory must be non-negative'].filter(Boolean) }));\nreturn [{ json: { rejectedCount: rejected.length, errors: rejected } }];"
      },
      "id": "1a222222-2222-4222-8222-222222222219",
      "name": "Error Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1370, 500]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "REPLACE_WITH_SLACK_CHANNEL"
        },
        "text": "={{ `Product feed rejected ${$json.rejectedCount} record(s): ${JSON.stringify($json.errors)}` }}",
        "otherOptions": {}
      },
      "id": "1a222222-2222-4222-8222-222222222220",
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1590, 500],
      "disabled": true,
      "notes": "Disabled for local demo; add a Slack credential and channel to send error alerts."
    },
    {
      "parameters": {
        "content": "# Multi-Vendor Product Feed Automation\nHourly supplier ingestion → normalization and validation → inventory reconciliation → reporting. Sample records are pinned so this demo runs locally without supplier endpoints or credentials.",
        "height": 180,
        "width": 510,
        "color": 5
      },
      "id": "1a222222-2222-4222-8222-222222222221",
      "name": "Workflow Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-10, -220]
    }
  ],
